# Copia este ficheiro para ".env" e preenche os valores reais.

# Chave secreta da tua conta Stripe (Dashboard -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_...

# Segredo do endpoint de webhook do Stripe (obténs ao criar o webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Domínio público onde a loja vai estar (sem "/" no fim)
DOMAIN=http://localhost:3000

# Porta onde o servidor corre localmente
PORT=3000

# Chave secreta à tua escolha para proteger os endpoints de admin (/api/admin/orders)
ADMIN_KEY=muda-esta-chave
